# Shell matrix image: current shells (see docs/superpowers/specs/2026-10-11-mssh-autocomplete-sp1-design.md)
FROM debian:trixie-slim
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends bash bash-completion zsh fish python3 python3-pytest procps xz-utils \
 && rm -rf /var/lib/apt/lists/*
ENV LANG=C.UTF-8
# ble.sh (Bash Line Editor), pinned: the autocomplete tests also run inside it
ADD --checksum=sha256:7a2445f138e7f099dd5dee749391a8b045646d1b8a605975885be5b34b6b5f7e \
    https://github.com/akinomyoga/ble.sh/releases/download/nightly/ble-nightly-20260908%2Bd81fd54.tar.xz /tmp/blesh.tar.xz
RUN mkdir -p /opt/blesh && tar -xJf /tmp/blesh.tar.xz -C /opt/blesh --strip-components=1 && rm /tmp/blesh.tar.xz
ENV MSSH_TEST_BLESH=/opt/blesh/ble.sh
# zsh-autosuggestions, pinned: the grey-text tests also run with it
ADD --checksum=sha256:0df7affff21cd87ed298e6a3970ed08a1dd66a6efa676454ee5b091ad503badf \
    https://github.com/zsh-users/zsh-autosuggestions/archive/refs/tags/v0.7.1.tar.gz /tmp/zas.tar.gz
RUN mkdir -p /opt/zsh-autosuggestions && tar -xzf /tmp/zas.tar.gz -C /opt/zsh-autosuggestions --strip-components=1 && rm /tmp/zas.tar.gz
# zsh-syntax-highlighting, pinned (0.8.0, as Debian 13 ships it): the warning tests also run with it
ADD --checksum=sha256:5981c19ebaab027e356fe1ee5284f7a021b89d4405cc53dc84b476c3aee9cc32 \
    https://github.com/zsh-users/zsh-syntax-highlighting/archive/refs/tags/0.8.0.tar.gz /tmp/zsyh.tar.gz
RUN mkdir -p /opt/zsh-syntax-highlighting && tar -xzf /tmp/zsyh.tar.gz -C /opt/zsh-syntax-highlighting --strip-components=1 && rm /tmp/zsyh.tar.gz
